<?xml version="1.0" encoding="utf-8"?>
<!--
  Bandival is self-hosted: many bands run it on a home server in the LAN (http) or with
  their own certificate authority. Cleartext and user-installed CAs are therefore allowed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
