# Copy to .env and fill in. Never commit the real .env.

# Database
POSTGRES_USER=bandival
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# App secret (min. 32 random characters), e.g.: openssl rand -base64 48
AUTH_SECRET=replace-with-long-random-secret

# Public URL + port
APP_PORT=3000
APP_BASE_URL=https://bandival.example.com
# true as soon as the app runs behind HTTPS (required for production)
COOKIE_SECURE=true
# Timezone used for calendar feeds, suggestions and e-mails
APP_TIMEZONE=Europe/Berlin

# Docker image
BANDIVAL_IMAGE=ghcr.io/f0up/bandival-web
BANDIVAL_TAG=latest

# Optional: e-mail for invites & notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bandival <noreply@example.com>

# Optional: allow importing calendars from LAN addresses (e.g. a Nextcloud on the same network)
CALENDAR_SYNC_ALLOW_PRIVATE=false

# ---------------------------------------------------------------- Accounts
# open = everyone can register, invite = only with an invitation, closed = no new accounts
REGISTRATION_MODE=open

# ---------------------------------------------------------------- Push & background jobs
# Web Push keys are generated automatically when empty (npx web-push generate-vapid-keys to pin them)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SCHEDULER_ENABLED=true
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=14

# ---------------------------------------------------------------- Optional AI
# Leave empty to disable. openai | gemini | ollama
# openai: AI_API_KEY=sk-…  (AI_BASE_URL for OpenAI-compatible servers, e.g. LM Studio / vLLM)
# gemini: AI_API_KEY=…      ollama: AI_BASE_URL=http://ollama:11434 (compose profile "ollama"), no key needed
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# Speech-to-text for voice memos (OpenAI: whisper-1 / gpt-4o-mini-transcribe; Gemini uses AI_MODEL)
AI_TRANSCRIBE_MODEL=

# Stem separation (vocals/drums/bass/other) with the self-hosted Demucs service:
#   docker compose --profile ai up -d   and set
# STEM_SEPARATION_URL=http://stem-splitter:8000
STEM_SEPARATION_URL=
STEM_SEPARATION_TOKEN=change-me-shared-secret
STEM_SEPARATION_MODEL=htdemucs

# ---------------------------------------------------------------- Optional Spotify playlist import
# https://developer.spotify.com/dashboard → create app → Client ID / Secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Security & sign-in
# ---------------------------------------------------------------------------
# Number of reverse proxies in front of Bandival that append to X-Forwarded-For
# (Caddy/Traefik/nginx = 1). Used for login rate limiting – 0 when exposed directly.
TRUSTED_PROXY_COUNT=1
# E-mail confirmation for new accounts (only active when SMTP is configured):
# required (default, app stays locked until confirmed) | optional | off
EMAIL_VERIFICATION=required
# Reject passwords from known data breaches (k-anonymity, only 5 hash characters leave the server).
# Set to false for instances without internet access.
PASSWORD_BREACH_CHECK=true
# false = no landing page at "/", visitors go straight to the login
LANDING_PAGE=true
# Passkeys in the Android app: SHA-256 fingerprint(s) of the APK signing certificate (AA:BB:…, comma separated).
# Published as /.well-known/assetlinks.json. Passkeys need https and a domain (not an IP address).
ANDROID_CERT_SHA256=
