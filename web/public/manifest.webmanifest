{
  "id": "/app",
  "name": "Bandival",
  "short_name": "Bandival",
  "description": "Band-Management: Songs, Setlists, Proben und Gigs an einem Ort.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "lang": "de-DE",
  "categories": ["music", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Kalender", "url": "/app/calendar", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Setlists", "url": "/app/setlists", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Songs", "url": "/app/songs", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
